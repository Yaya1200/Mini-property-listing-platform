"request": {
"method": "POST",
"header": [
{
"key": "Content-Type",
"value": "application/json"
}
],
"body": {
"mode": "raw",
"raw": "{\n  "name": "John Doe",\n  "email": "[john@example.com](mailto:john@example.com)",\n  "password": "Password123!",\n  "role": "regular_user"\n}"
},
"url": {
"raw": "{{baseUrl}}/auth/register",
"host": [
"{{baseUrl}}"
],
"path": [
"auth",
"register"
]
}
}
},
